*.user
*.suo
*.DotSettings.user
.vs/
.idea/
.vscode/
riderModule.iml
/_ReSharper.Caches/

# Test results and coverage
TestResults/
*.coverage
*.coveragexml
coverage*.xml
coverage*.json

# OS files
.DS_Store
Thumbs.db

# Local notes (not tracked)
docs/

# Pubwiz's own exports (default names) and local test setup from running the tool in its project folder
pubwiz-logs-*/
pubwiz-report-*.json
pubwiz-report-*.csv
src/Pubwiz.Tool/Properties/PublishProfiles/
src/Pubwiz.Tool/pubwiz.json
